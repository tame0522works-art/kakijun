{
  "name": "kakijun",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "漢字を手で書いて、1画ずつ書き順・向き・形を確かめる",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "fetch": "tsx tools/fetch.ts",
    "convert": "tsx tools/convert.ts",
    "check": "npm run check:data && npm run check:judge",
    "check:data": "tsx tools/check-data.ts",
    "check:judge": "tsx tools/check-judge.ts",
    "e2e": "vite build --outDir dist-e2e --emptyOutDir && tsx tools/e2e.ts",
    "screenshots": "tsx tools/screenshots.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
